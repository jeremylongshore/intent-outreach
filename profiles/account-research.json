{
  "name": "Account Research",
  "description": "Account-research preference set with no messages section. Connector and extra-field entries are schema metadata until a caller explicitly wires them; the markdown renderer honors the selected report sections when given this profile.",
  "intake": {
    "connectors": [
      "apollo",
      "hunter",
      "clearbit",
      "crunchbase",
      "leadmagic",
      "exa",
      "peopledatalabs"
    ],
    "extraFields": [
      "funding",
      "techStack",
      "news",
      "headcount",
      "competitors",
      "verifiedEmail",
      "phone"
    ]
  },
  "filtering": {
    "minScore": 80,
    "companyFilters": [],
    "contactTitles": []
  },
  "outreach": {
    "maxContactsPerLead": 5
  },
  "structure": {
    "sections": ["summary", "leads", "contacts", "cost"]
  },
  "output": {
    "formats": ["markdown", "json", "csv"]
  },
  "delivery": {
    "targets": ["file"],
    "dir": "./reports/account-research"
  }
}
