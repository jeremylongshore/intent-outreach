{
  "name": "intent-outreach",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Intent Outreach — a model-agnostic, Claude-Code-native SDR orchestrator (research → enrich → outreach). Local-only, BYO keys, zero Google dependency.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jeremy Longshore <jeremy@intentsolutions.io> (https://intentsolutions.io)",
  "homepage": "https://github.com/jeremylongshore/intent-outreach",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "intent-outreach": "bundle/cli.mjs"
  },
  "files": [
    "bundle/",
    "prompts/",
    "pipeline_core/",
    "mcp/",
    "skills/",
    "agents/",
    "hooks/",
    "profiles/",
    ".mcp.json",
    ".claude-plugin/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('prompts','dist/prompts',{recursive:true})\"",
    "bundle": "esbuild mcp/server.ts --bundle --platform=node --format=esm --define:__INTENT_OUTREACH_VERSION__=\\\"$npm_package_version\\\" --outfile=bundle/server.mjs && esbuild cli.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=bundle/cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx mcp/server.ts",
    "evals": "tsx evals/run.ts --providers anthropic --repeat 3",
    "evals:promote": "tsx evals/promote.ts",
    "lint": "biome lint .",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/mcp.e2e.test.ts tests/cli.e2e.test.ts",
    "test:architecture": "vitest run tests/architecture.test.ts",
    "mutation": "stryker run",
    "audit:gate": "node .github/scripts/audit-gate.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.63",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ai": "^7.0.114",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@ai-sdk/openai": "^4.0.75",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/xai": "^4.0.59"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
