{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "npx vitest run tests/compliance.test.ts tests/core.test.ts tests/store.test.ts tests/security.test.ts tests/packs.test.ts tests/pipeline.test.ts" },
  "tsconfigFile": "tsconfig.stryker-unused.json",
  "mutate": ["pipeline_core/compliance/**/*.ts", "pipeline_core/validator.ts"],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "concurrency": 4,
  "timeoutMS": 120000,
  "thresholds": { "high": 85, "low": 70, "break": 67 }
}
